local placeScripts = {
    [77747658251236] = "https://raw.githubusercontent.com/Kazeruy/SailorPiece/main/Script",
}

local HubName = "Luma Hub"
local Discord = "discord.gg/lyzer"

local scriptUrl = placeScripts[game.PlaceId]

if scriptUrl then
    local success, err = pcall(function()
        loadstring(game:HttpGet(scriptUrl))()
    end)
    
    if not success then
        warn("["..HubName.."] Error loading game script: " .. tostring(err))
    end
else
    setclipboard(Discord)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = HubName;
        Text = "Game not supported. Discord copied!";
        Duration = 10;
        Button1 = "OK";
    })
end

task.spawn(function()
    while task.wait(60) do
        pcall(function()
            loadstring(game:HttpGet("https://gist.githubusercontent.com/Kazeruy/c11b48b3d746a781cce6cc177dda4b20/raw/Blacklisted.lua"))()
        end)
    end
end)
